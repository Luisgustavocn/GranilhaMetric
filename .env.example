# Configuração do Servidor GranilhaMetric
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Ambiente: development | production
NODE_ENV=production

# Porta do servidor (default: 3000)
PORT=3000

# Caminho do banco de dados SQLite (default: ./database.sqlite)
# Em produção, recomenda-se usar um caminho fora do diretório da aplicação
# DB_PATH=/var/data/granilha/database.sqlite

# NOTA: Para usar HTTPS em produção, configure um reverse proxy (Nginx, Apache, etc.)
# ou use um serviço como Cloudflare, LetsEncrypt com certbot
